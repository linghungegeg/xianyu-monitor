# Only use generated, distinct 32-byte-or-longer secrets. Do not commit a real .env file.
DATABASE_URL=postgresql://xianyu:[REPLACE_WITH_SECRET]@127.0.0.1:5432/xianyu_monitor
DATABASE_SSL=false
CLOUD_API_HOST=127.0.0.1
USER_API_PORT=3101
ADMIN_API_PORT=3102
COLLECTOR_API_PORT=3103
# Comma-separated HTTP(S) origins; never use *.
USER_ALLOWED_ORIGINS=http://localhost:5174
ADMIN_ALLOWED_ORIGINS=http://localhost:5175
USER_TOKEN_ISSUER=https://user-api.placeholder.invalid
USER_TOKEN_AUDIENCE=user-api
USER_TOKEN_SECRET=[REPLACE_WITH_32_BYTE_MINIMUM_SECRET]
ADMIN_TOKEN_ISSUER=https://admin-api.placeholder.invalid
ADMIN_TOKEN_AUDIENCE=admin-api
ADMIN_TOKEN_SECRET=[REPLACE_WITH_32_BYTE_MINIMUM_SECRET]
COLLECTOR_TOKEN_ISSUER=https://collector-api.placeholder.invalid
COLLECTOR_TOKEN_AUDIENCE=collector-api
COLLECTOR_TOKEN_SECRET=[REPLACE_WITH_32_BYTE_MINIMUM_SECRET]
