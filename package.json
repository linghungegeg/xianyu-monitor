{
  "name": "xianyu-monitor-desktop",
  "version": "0.1.0",
  "description": "Local Xianyu search monitor desktop application",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package:win": "npm run build && electron-builder --win",
    "check:cloud": "tsc -p tsconfig.cloud.json",
    "serve:cloud": "node --experimental-strip-types services/cloud/src/main.ts",
    "test:phase0:contract": "node tools/phase0/postgres-contract-test.mjs",
    "test:phase0:stress": "node tools/phase0/sqlite-synthetic-load.mjs --items=100000 --devices=4 --batch-size=250 --database=temp"
  },
  "dependencies": {
    "@electron-toolkit/utils": "4.0.0",
    "fastify": "^5.12.0",
    "jose": "^6.2.9",
    "lucide-react": "0.468.0",
    "pg": "^8.23.0",
    "playwright-core": "1.62.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@electron-toolkit/tsconfig": "1.0.1",
    "@types/node": "24.10.1",
    "@types/pg": "^8.15.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "build": {
    "appId": "com.local.xianyumonitor",
    "productName": "闲鱼监控",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "allowScripts": {
    "electron@43.4.0": true
  }
}
